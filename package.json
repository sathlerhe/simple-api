{
  "name": "simple-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --require tsconfig-paths/register --test test/*.spec.ts",
    "test:watch": "node --import tsx --require tsconfig-paths/register --test --watch test/*.spec.ts",
    "test:cov": "c8 -r --check-coverage --lines 100 --functions 100 --branches 100 --statements 100 --reporter=lcov node --import tsx --test ./test/*.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "c8": "^10.1.3",
    "supertest": "^7.1.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
